# Nahid Meet: .env leve para o docker-jitsi-meet (stable-11248) numa VPS de 2 vCPU / 4 GB.
# Copie para o diretório do docker-jitsi-meet como .env e rode ./gen-passwords.sh.
# Nomes conferidos em docker-compose.yml e web/rootfs/defaults/settings-config.js da tag stable-11248.

# ---- Básico ---------------------------------------------------------------
CONFIG=/srv/apps/jitsi/config
TZ=America/Sao_Paulo
JITSI_IMAGE_VERSION=stable-11248
# Imagem web própria (ver docker-compose.override.yml). Mesma versão das demais.
NAHID_MEET_IMAGE=ghcr.io/rodrigonahid/nahid-meet-web:stable-11248
PUBLIC_URL=https://meet.rodrigonahid.com.br
DEFAULT_LANGUAGE=ptBR

# O compose oficial exige essas portas, mas o override remove a publicação delas:
# o Caddy (container "site") faz o TLS e o proxy pela rede Docker "web".
HTTP_PORT=8000
HTTPS_PORT=8443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

# ---- Mídia (JVB) ----------------------------------------------------------
# IP público da VPS; a porta UDP 10000 precisa estar aberta no firewall.
JVB_ADVERTISE_IPS=143.95.170.215
JVB_PORT=10000

# ---- Leveza ---------------------------------------------------------------
# Heap máxima do Java (o padrão do compose seria 3 GB cada).
VIDEOBRIDGE_MAX_MEMORY=768m
JICOFO_MAX_MEMORY=384m

# Chamadas de 2 pessoas vão direto entre os navegadores, sem passar pelo JVB.
ENABLE_P2P=1

# Captura máxima de 720p (1280x720).
RESOLUTION=720
RESOLUTION_WIDTH=1280

# channelLastN não tem variável no template; está em custom-config.js.

# Desligados: gravação (Jibri), SIP/transcrição (Jigasi), Etherpad, whiteboard.
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
#ETHERPAD_URL_BASE=
#WHITEBOARD_COLLAB_SERVER_PUBLIC_URL=
DISABLE_DEEP_LINKING=true
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1

# ---- Autenticação (próxima etapa: portal Next.js + Better Auth) ------------
# O portal faz login com Google e assina um JWT (HS256) com JWT_APP_SECRET,
# depois redireciona para https://meet.rodrigonahid.com.br/<sala>?jwt=<token>.
# Para ativar, descomente e preencha:
#ENABLE_AUTH=1
#AUTH_TYPE=jwt
#JWT_APP_ID=nahid-meet
#JWT_APP_SECRET=<openssl rand -hex 32>
#JWT_ACCEPTED_ISSUERS=nahid-portal
#JWT_ACCEPTED_AUDIENCES=nahid-meet
# Convidados sem conta entram depois que um usuário autenticado abrir a sala:
#ENABLE_GUESTS=1
# Para onde mandar quem chega sem token ({room} é trocado pelo nome da sala):
#TOKEN_AUTH_URL=https://portal.rodrigonahid.com.br/meet/{room}

# ---- Senhas internas (preenchidas por ./gen-passwords.sh) -------------------
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
